<?xml version="1.0" encoding="utf-8"?>
<template:TemplateWindow
    x:Class="CDPIUI.ConditionalLaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:navigation="using:CDPIUI.Controls.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:CDPIUI.Default"
    xmlns:wc="using:CDPIUI.Controls.WindowControls" xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <template:TemplateWindow.SystemBackdrop>
        <MicaBackdrop />
    </template:TemplateWindow.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Storyboard x:Name="ShowInfoBarAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="StatusInfoBarTranslateTransform"
                    Storyboard.TargetProperty="X"
                    From="-1000"
                    To="0"
                    Duration="00:00:0.4">
                    <DoubleAnimation.EasingFunction>
                        <QuinticEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Name="HideInfoBarAnimation">
                <DoubleAnimation
                    Storyboard.TargetName="StatusInfoBarTranslateTransform"
                    Storyboard.TargetProperty="X"
                    From="0"
                    To="-1000"
                    Duration="00:00:0.4">
                    <DoubleAnimation.EasingFunction>
                        <QuinticEase EasingMode="EaseIn" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <MenuFlyout x:Key="TaskContextMenu">
                <MenuFlyoutItem
                    l:Uids.Uid="CL_RunTaskMenuItem"
                    KeyboardAcceleratorTextOverride="Ctrl+R"
                    Click="RunTaskMenuItem_Click" />
                <MenuFlyoutItem
                    Tag="ToggleEnabled"
                    Click="ToggleTaskEnabledMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    l:Uids.Uid="CL_PropertiesTaskMenuItem"
                    KeyboardAcceleratorTextOverride="Enter"
                    Click="PropertiesTaskMenuItem_Click" />
                <MenuFlyoutItem
                    l:Uids.Uid="CL_DeleteTaskMenuItem"
                    KeyboardAcceleratorTextOverride="Del"
                    Click="DeleteTaskMenuItem_Click" />
            </MenuFlyout>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wc:TitleBarUserControl
            x:Name="TitleBarUserControl"
            Height="48"
            ShowControlsContent="False" />

        <Grid Grid.Row="1" Padding="16,12,16,16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            x:Name="NewTaskButton"
                            Padding="6"
                            l:Uids.Uid="CL_NewTaskButton"
                            Click="NewTaskButton_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                        </Button>
                        <Button
                            x:Name="EditButton"
                            Padding="6"
                            l:Uids.Uid="CL_EditTaskButton"
                            Click="EditButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            x:Name="DeleteButton"
                            Padding="6"
                            l:Uids.Uid="CL_DeleteButton"
                            Click="DeleteButton_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </Button.KeyboardAccelerators>
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            x:Name="RunButton"
                            Padding="6"
                            l:Uids.Uid="CL_RunTaskButton"
                            Click="RunTaskButton_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="R" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                        </Button>
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Height="22"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            Padding="6"
                            l:Uids.Uid="CL_ImportButton"
                            Click="ImportButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        </Button>
                        <Button
                            x:Name="ExportButton"
                            Padding="6"
                            l:Uids.Uid="CL_ExportButton"
                            Click="ExportButton_Click">
                            <FontIcon FontSize="16" Glyph="&#xE74E;" />
                        </Button>
                        <Button
                            x:Name="ReloadButton"
                            Padding="6"
                            l:Uids.Uid="CL_ReloadButton"
                            Click="ReloadButton_Click">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </Button.KeyboardAccelerators>
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        </Button>
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Height="22"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Button Padding="6" l:Uids.Uid="CL_HelpButton">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    Tag="ConditionalLaunch/Overview"
                                    l:Uids.Uid="CL_HelpOverviewMenuItem"
                                    Click="HelpMenuItem_Click" />
                                <MenuFlyoutItem
                                    Tag="ConditionalLaunch/CreatingTasks"
                                    l:Uids.Uid="CL_HelpCreatingTasksMenuItem"
                                    Click="HelpMenuItem_Click" />
                                <MenuFlyoutItem
                                    Tag="ConditionalLaunch/TriggersAndActions"
                                    l:Uids.Uid="CL_HelpTriggersAndActionsMenuItem"
                                    Click="HelpMenuItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="16" Glyph="&#xE897;" />
                    </Button>
                </StackPanel>

            </Grid>

            <Border 
                x:Name="TasksBorder"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="13,0"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" l:Uids.Uid="CL_TaskNameColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" l:Uids.Uid="CL_TaskStatusColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" l:Uids.Uid="CL_TaskTriggerColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" l:Uids.Uid="CL_TaskPriorityColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Grid>

                    <ListView
                        x:Name="TaskListView"
                        Grid.Row="1"
                        ItemsSource="{x:Bind Tasks}"
                        DoubleTapped="TaskListView_DoubleTapped"
                        KeyDown="TaskListView_KeyDown"
                        RightTapped="TaskListView_RightTapped"
                        SelectionChanged="TaskListView_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="9,0" />
                                <Setter Property="MinHeight" Value="38" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,7" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding TriggerSummary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding PriorityLabel}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="EmptyTaskListPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE8F1;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock HorizontalAlignment="Center" l:Uids.Uid="CL_EmptyTaskListTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock HorizontalAlignment="Center" l:Uids.Uid="CL_EmptyTaskListDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:ContentSizer Grid.Row="2"
                                   TargetControl="{x:Bind TasksBorder}"
                                   Orientation="Horizontal"
                                   Height="16"
                                   />


            <Grid Grid.Row="3" x:Name="PreviewGrid">
                <StackPanel
                    x:Name="NoSelectionPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <FontIcon HorizontalAlignment="Center" FontSize="32" Glyph="&#xE9D5;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock HorizontalAlignment="Center" l:Uids.Uid="CL_NoSelectionTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock HorizontalAlignment="Center" l:Uids.Uid="CL_NoSelectionDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <navigation:AnimatedSelectorBar
                    x:Name="PreviewSelector"
                    Visibility="Collapsed">
                    <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_GeneralTab">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Padding="16,12" ColumnSpacing="22" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock l:Uids.Uid="CL_NameLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PreviewNameTextBlock" Grid.Column="1" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" l:Uids.Uid="CL_StatusLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PreviewStatusTextBlock" Grid.Row="1" Grid.Column="1" />
                                <TextBlock Grid.Row="2" l:Uids.Uid="CL_PriorityLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PreviewPriorityTextBlock" Grid.Row="2" Grid.Column="1" />
                                <TextBlock Grid.Row="3" l:Uids.Uid="CL_FileLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PreviewFileTextBlock" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </ScrollViewer>
                    </navigation:AnimatedSelectorBarItem>

                    <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_TriggersTab">
                        <Border Margin="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="10,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" l:Uids.Uid="CL_TaskTriggerColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" l:Uids.Uid="CL_DetailsColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind PreviewTriggers}" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="2,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </navigation:AnimatedSelectorBarItem>

                    <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_ActionsTab">
                        <Border Margin="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Padding="10,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" l:Uids.Uid="CL_OrderColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" l:Uids.Uid="CL_ActionColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" l:Uids.Uid="CL_DetailsColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ListView Grid.Row="1" ItemsSource="{x:Bind PreviewActions}" SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="2,6" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock HorizontalAlignment="Center" Text="{Binding Order}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </navigation:AnimatedSelectorBarItem>
                </navigation:AnimatedSelectorBar>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Canvas.ZIndex="100"
            Margin="20,0,20,20"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsIconVisible="True"
            IsOpen="False"
            Closing="StatusInfoBar_Closing">
            <InfoBar.RenderTransform>
                <TranslateTransform x:Name="StatusInfoBarTranslateTransform" />
            </InfoBar.RenderTransform>
        </InfoBar>
    </Grid>
</template:TemplateWindow>
