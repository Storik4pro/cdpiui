<?xml version="1.0" encoding="utf-8"?>
<template:TemplateWindow
    x:Class="CDPIUI.ConditionalTaskEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:navigation="using:CDPIUI.Controls.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:CDPIUI.Default"
    xmlns:wc="using:CDPIUI.Controls.WindowControls"
    mc:Ignorable="d">

    <template:TemplateWindow.SystemBackdrop>
        <MicaBackdrop />
    </template:TemplateWindow.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wc:TitleBarUserControl
            x:Name="TitleBarUserControl"
            Height="48"
            ShowControlsContent="False" />
        
        <navigation:AnimatedSelectorBar
            Grid.Row="2"
            Margin="12,0,12,12">
            <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_GeneralTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="16,14" ColumnSpacing="16" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            l:Uids.Uid="CL_NameLabel"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBox
                            x:Name="TaskNameTextBox"
                            Grid.Column="1"
                            l:Uids.Uid="CL_TaskNameEditorTextBox" />

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            l:Uids.Uid="CL_PriorityLabel"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ComboBox
                            x:Name="PriorityComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            HorizontalAlignment="Stretch" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,4,0,0"
                            Spacing="8">
                            <CheckBox
                                x:Name="TaskEnabledCheckBox"
                                l:Uids.Uid="CL_TaskEnabledCheckBox"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="StopAfterErrorCheckBox"
                                l:Uids.Uid="CL_StopAfterErrorCheckBox"
                                IsChecked="True" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </navigation:AnimatedSelectorBarItem>

            <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_TriggersTab">
                <Grid Padding="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,10"
                        l:Uids.Uid="CL_TriggerTabHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                Padding="10,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" l:Uids.Uid="CL_TaskTriggerColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" l:Uids.Uid="CL_DetailsColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" l:Uids.Uid="CL_TaskStatusColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Grid>
                            <ListView
                                x:Name="TriggerListView"
                                Grid.Row="1"
                                ItemsSource="{x:Bind Triggers}"
                                SelectionMode="Single"
                                DoubleTapped="TriggerListView_DoubleTapped"
                                SelectionChanged="TriggerListView_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="36" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="2,5" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateTriggerButton" l:Uids.Uid="CL_CreateTriggerButton" Click="CreateTriggerButton_Click" />
                        <Button x:Name="EditTriggerButton" l:Uids.Uid="CL_EditTriggerButton" Click="EditTriggerButton_Click" />
                        <Button x:Name="DeleteTriggerButton" l:Uids.Uid="CL_DeleteTriggerButton" Click="DeleteTriggerButton_Click" />
                    </StackPanel>

                </Grid>
            </navigation:AnimatedSelectorBarItem>

            <navigation:AnimatedSelectorBarItem l:Uids.Uid="CL_ActionsTab">
                <Grid Padding="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,10"
                        l:Uids.Uid="CL_ActionTabHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Padding="10,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" l:Uids.Uid="CL_OrderColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" l:Uids.Uid="CL_ActionColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" l:Uids.Uid="CL_DetailsColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>
                                <ListView
                                    x:Name="ActionListView"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind Actions}"
                                    SelectionMode="Single"
                                    DoubleTapped="ActionListView_DoubleTapped"
                                    SelectionChanged="ActionListView_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="MinHeight" Value="36" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="2,5" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Order}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Button Padding="6" l:Uids.Uid="CL_MoveActionUpButton" Click="MoveActionUpButton_Click">
                                <FontIcon FontSize="16" Glyph="&#xE70E;" />
                            </Button>
                            <Button Padding="6" l:Uids.Uid="CL_MoveActionDownButton" Click="MoveActionDownButton_Click">
                                <FontIcon FontSize="16" Glyph="&#xE70D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <Button l:Uids.Uid="CL_CreateActionButton" Click="CreateActionButton_Click" />
                        <Button x:Name="EditActionButton" l:Uids.Uid="CL_EditActionTextButton" Click="EditActionButton_Click" />
                        <Button x:Name="RemoveActionButton" l:Uids.Uid="CL_DeleteActionButton" Click="RemoveActionButton_Click" />
                    </StackPanel>

                </Grid>
            </navigation:AnimatedSelectorBarItem>
        </navigation:AnimatedSelectorBar>

        <InfoBar
             x:Name="StatusInfoBar"
             Grid.Row="3"
             Margin="12,0,12,0"
             IsOpen="False"
             IsClosable="True" />

        <Border
            Grid.Row="4"
            Padding="10,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Padding="8, 7, 7, 7"
                    VerticalAlignment="Stretch"
                    l:Uids.Uid="CL_EditorHelpButton"
                    Click="EditorHelpButton_Click">
                    <FontIcon FontSize="16" Glyph="&#xE9CE;" />
                </Button>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button l:Uids.Uid="CL_OkEditorButton" Style="{ThemeResource AccentButtonStyle}" Click="SaveTaskButton_Click" MinWidth="150"/>
                    <Button l:Uids.Uid="CL_CancelEditorButton" Click="CancelButton_Click" MinWidth="150" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</template:TemplateWindow>
