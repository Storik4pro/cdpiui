<?xml version="1.0" encoding="utf-8"?>
<template:TemplateWindow
    x:Class="CDPIUI.AppFeaturesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    xmlns:navigation="using:CDPIUI.Controls.Navigation"
    xmlns:template="using:CDPIUI.Default"
    xmlns:ucontrols="using:CDPIUI.Controls.Universal"
    xmlns:vm="using:CDPIUI.ViewModels"
    xmlns:wc="using:CDPIUI.Controls.WindowControls">

    <template:TemplateWindow.SystemBackdrop>
        <MicaBackdrop />
    </template:TemplateWindow.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <DataTemplate x:Key="FeatureContentTemplate" x:DataType="vm:AppFeatureViewModel">
                <Grid Padding="0" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border
                                Height="180"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="0"
                                Visibility="{x:Bind ImageVisibility, Mode=OneWay}">
                                <Image
                                    Source="{x:Bind ImageSource, Mode=OneWay}"
                                    Margin="0"
                                    Stretch="Uniform" />
                            </Border>

                            <TextBlock
                                Text="{x:Bind Title, Mode=OneWay}"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                TextWrapping="Wrap" Margin="20 16 20 16" />

                            <TextBlock
                                Text="{x:Bind Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                                Margin="20 0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ItemsControl
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        ItemsSource="{x:Bind Links, Mode=OneWay}"
                        Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppFeatureLinkViewModel">
                                <ucontrols:URIButton
                                    DisplayText="{x:Bind DisplayText, Mode=OneWay}"
                                    URI="{x:Bind URI, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <wc:TitleBarUserControl
            x:Name="TitleBarUserControl"
            Height="48" />

        <Grid Grid.Row="1" Padding="10,0,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                l:Uids.Uid="AppFeaturesHeadingTextBlock"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"
                Margin="15 0 0 0" Visibility="Collapsed"/>

            <Grid Grid.Row="1" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView
                    x:Name="FeatureListView"
                    ItemsSource="{x:Bind Features, Mode=OneWay}"
                    SelectionChanged="FeatureListView_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppFeatureViewModel">
                            <Grid>
                                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 10 0 0" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}" Canvas.ZIndex="1">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3"/>
                                    <TextBlock Text="NEW" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="2 0"/>
                                </Grid>
                                <Grid Padding="12,10" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                    <TextBlock
                                    Grid.Row="1"
                                    Text="{x:Bind Description, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="3"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Margin="0 0 10 0"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <navigation:AnimatedHorizontalContentViewer x:Name="FeatureContentViewer" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</template:TemplateWindow>
