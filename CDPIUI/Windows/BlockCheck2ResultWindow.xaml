<?xml version="1.0" encoding="utf-8"?>
<template:TemplateWindow
    x:Class="CDPIUI.BlockCheck2ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:template="using:CDPIUI.Default"
    xmlns:l="using:WinUI3Localizer"
    xmlns:universal="using:CDPIUI.Controls.Universal"
    xmlns:wc="using:CDPIUI.Controls.WindowControls"
    mc:Ignorable="d"
    xmlns:menu="using:CDPIUI.Controls.MenuManagement"
    xmlns:commands="using:CDPIUI.Commands">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppBar" Height="Auto" />
            <RowDefinition x:Name="FuncBar" Height="36" />
            <RowDefinition x:Name="View" Height="*" />
            <RowDefinition x:Name="StatusBar" Height="28" />
        </Grid.RowDefinitions>
        <wc:TitleBarUserControl
            x:Name="TitleBarUserControl"
            Height="36"
            ShowControlsContent="False" />

        <Grid Grid.RowSpan="5" x:Name="LoadingGrid" 
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="1" l:Uids.Uid="WorkingOnItTextBlock" HorizontalAlignment="Center"/>
            <ProgressRing Grid.Row="2" Width="30" Height="30" HorizontalAlignment="Center" Margin="0 10"/>
        </Grid>

        <Grid
            Grid.Row="1"
            Height="32"
            Margin="0">
            <Rectangle Fill="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" Width="Auto" 
                       VerticalAlignment="Stretch"/>
            <MenuBar
                x:Name="ActionMenu"
                menu:MenuBarHost.Frame="{x:Bind ContentFrame, Mode=OneTime}"
                VerticalAlignment="Center">
                <MenuBarItem
                    l:Uids.Uid="FileMenuItem"
                    menu:MenuBarNode.Id="file"
                    menu:MenuBarNode.Order="100">
                    <MenuFlyoutItem
                        x:Name="SaveToApplicationMenuItem"
                        l:Uids.Uid="BlockCheck2SaveToApplicationWindowMenuItem"
                        Click="SaveToApplicationItem_Click"
                        menu:MenuBarNode.Id="window.save-to-application"
                        menu:MenuBarNode.Order="100"
                        Visibility="Collapsed">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="S" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE792;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        l:Uids.Uid="BlockCheck2SaveJsonReportButtonText"
                        Click="SaveJsonReportItem_Click"
                        menu:MenuBarNode.Id="window.save-json-report"
                        menu:MenuBarNode.Order="500">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="J" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8E5;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        l:Uids.Uid="BlockCheck2SaveTextReportButtonText"
                        Click="SaveTextReportItem_Click"
                        menu:MenuBarNode.Id="window.save-text-report"
                        menu:MenuBarNode.Order="600">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control,Shift" Key="T" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator menu:MenuBarNode.Id="window.file-close-separator" menu:MenuBarNode.Order="900" />
                    <MenuFlyoutItem
                        l:Uids.Uid="ConfigMakerExitMenuItem"
                        Click="CloseItem_Click"
                        menu:MenuBarNode.Id="window.close"
                        menu:MenuBarNode.Order="1000">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="W" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem
                    l:Uids.Uid="ActionsMenuItem"
                    menu:MenuBarNode.Id="actions"
                    menu:MenuBarNode.Order="400">
                    <MenuFlyoutItem
                        x:Name="BackToBuilderMenuItem"
                        l:Uids.Uid="BlockCheck2BackToBuilderButtonText"
                        Click="BackToBuilderItem_Click"
                        menu:MenuBarNode.Id="window.back-to-builder"
                        menu:MenuBarNode.Order="900"
                        Visibility="Collapsed">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72B;" />
                        </MenuFlyoutItem.Icon>
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem 
                    l:Uids.Uid="HelpMenuItem"
                    menu:MenuBarNode.Id="help"
                    menu:MenuBarNode.Order="9999">
                    <MenuFlyoutItem
                        l:Uids.Uid="CallHelpMenuItem"
                        menu:MenuBarNode.Id="help.call-help"
                        menu:MenuBarNode.Order="1000"
                        Command="{x:Bind commands:CommandsHandler.Instance.Command, Mode=OneTime}"
                        CommandParameter="cdpiui://Help/Zapret2PresetSelection/4ResultsAndPreset">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F1"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator menu:MenuBarNode.Order="1100"/>
                    <MenuFlyoutItem
                        l:Uids.Uid="RateThisAppMenuItem"
                        menu:MenuBarNode.Id="help.rate-app"
                        menu:MenuBarNode.Order="1200"
                        Command="{x:Bind commands:CommandsHandler.Instance.Command, Mode=OneTime}"
                        CommandParameter="cdpiui://RateFeature/ConfigAutoSelection">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE734;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        l:Uids.Uid="ReportIssueMenuItem"
                        menu:MenuBarNode.Id="help.report"
                        menu:MenuBarNode.Order="1300"
                        Command="{x:Bind commands:ExternalUriLauncher.Instance.Command, Mode=OneTime}"
                        CommandParameter="https://github.com/Storik4pro/cdpiui/issues">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7C1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="2">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>

        <Grid Grid.Row="3" >
            <Rectangle Fill="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" Height="32" Width="Auto" 
                       VerticalAlignment="Bottom"/>
            <Grid Padding="10 0 20 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <ListView Style="{StaticResource HorizontalSeparatedListViewStyle}" x:Name="StatusBarListView"/>
            </Grid>
        </Grid>

        <universal:StatusNotificationControl
            x:Name="NotificationCenter"
            Grid.Row="2"
            Grid.RowSpan="2"
            Canvas.ZIndex="100"
            Margin="0,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom" />
    </Grid>
</template:TemplateWindow>
