<?xml version="1.0" encoding="utf-8"?>
<control:SettingsExpander
    l:Uids.Uid="AdSettingsExpander"
    x:Class="CDPIUI.Controls.Settings.AdUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPIUI.Controls.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:control="using:CommunityToolkit.WinUI.Controls"
    xmlns:ue="using:CDPIUI.Helper.UserExperience"
    xmlns:l="using:WinUI3Localizer"
    IsExpanded="{x:Bind ue:AdHelper.Instance.ShowAd, Mode=OneWay}"
    ItemsSource="{x:Bind ue:AdHelper.Instance.AdSettings}">

    <control:SettingsExpander.HeaderIcon>
        <FontIcon Glyph="&#xE789;" />
    </control:SettingsExpander.HeaderIcon>

    <ToggleSwitch IsOn="{x:Bind ue:AdHelper.Instance.ShowAd, Mode=TwoWay}"/>
    <control:SettingsExpander.ItemTemplate>
        <DataTemplate x:DataType="ue:AdViewModel">
            <control:SettingsCard ContentAlignment="Left" IsEnabled="{x:Bind ue:AdHelper.Instance.ShowAd, Mode=OneWay}">
                <CheckBox Content="{x:Bind Name, Mode=OneWay}" IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
            </control:SettingsCard>
        </DataTemplate>
    </control:SettingsExpander.ItemTemplate>
</control:SettingsExpander>
