<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Name="RootControl"
    x:Class="CDPIUI.Controls.Store.StoreReadyKitButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:vm="using:CDPIUI.ViewModels"
    xmlns:l="using:WinUI3Localizer"
    xmlns:triggers="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    MinWidth="260"
    MinHeight="110"
    SizeChanged="RootControl_SizeChanged">

    <UserControl.Resources>
        <Style x:Key="ReadyKitButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultSolidBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ShadowHost" RenderTransformOrigin="0.5,0.5">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="SSmallView">
                    <VisualState.Setters>
                        <Setter Target="CardSubtitleTextBlock.Visibility" Value="Collapsed"/>
                        <Setter Target="AdditionalInfoStackPanel.Orientation" Value="Horizontal"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NormalView">
                    <VisualState.Setters>
                        <Setter Target="CardSubtitleTextBlock.Visibility" Value="Visible"/>
                        <Setter Target="AdditionalInfoStackPanel.Orientation" Value="Vertical"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="BasicView">
                    <VisualState.Setters>
                        <Setter Target="CardSubtitleTextBlock.Visibility" Value="Visible"/>
                        <Setter Target="AdditionalInfoStackPanel.Orientation" Value="Vertical"/>
                        <Setter Target="MainStackPanel.VerticalAlignment" Value="Bottom"/>
                        <Setter Target="CardSubtitleTextBlock.Visibility" Value="Collapsed"/>

                        <Setter Target="PART_Image.(Grid.Column)" Value="0"/>
                        <Setter Target="PART_Image.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="PART_Image.VerticalAlignment" Value="Top"/>
                        <Setter Target="PART_Image.HorizontalAlignment" Value="Left"/>
                        <Setter Target="PART_Image.Margin" Value="0"/>
                        <Setter Target="MainStackPanel.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RenderTransform>
            <TranslateTransform x:Name="TranslateTransform"/>
        </Grid.RenderTransform>
        <Grid.Resources>
            <ThemeShadow x:Name="SharedShadow"/>
        </Grid.Resources>

        <Grid x:Name="ShadowReceiver" Background="Transparent"/>
        <Button
            x:Name="PART_Button"
            Style="{StaticResource ReadyKitButtonStyle}"
            Shadow="{StaticResource SharedShadow}"
            Click="PART_Button_Click"
            PointerEntered="PART_Button_PointerEntered"
            PointerExited="PART_Button_PointerExited"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            HorizontalContentAlignment="Stretch">

            

            <Grid>
                

                <Border
                    Background="{Binding CardBackgroundBrush, ElementName=RootControl}"
                    CornerRadius="10"/>
                <Border Background="#66000000" CornerRadius="10"/>

                <Grid Padding="28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="MainStackPanel" VerticalAlignment="Center" Spacing="7">
                        
                        <TextBlock
                            Text="{Binding CardTitle, ElementName=RootControl}"
                            FontSize="{Binding TitleFontSize, ElementName=RootControl}"
                            FontWeight="SemiBold"
                            Foreground="White"
                            TextWrapping="Wrap"
                            MaxLines="1"/>
                        <TextBlock
                            x:Name="CardSubtitleTextBlock"
                            Text="{Binding CardSubtitle, ElementName=RootControl}"
                            FontSize="14"
                            Foreground="#E6FFFFFF"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            Grid.Row="1"/>
                        <StackPanel x:Name="AdditionalInfoStackPanel" Spacing="10">
                            <Button Grid.Row="2" CornerRadius="15" Padding="0" Click="PART_Button_Click">
                                <Grid>
                                    <TextBlock l:Uids.Uid="DetailsTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="10 5"/>
                                </Grid>
                            </Button>
                            <ListView x:Name="ContainItemsListView" 
                                  ItemsSource="{Binding Items, ElementName=RootControl}" 
                                  Grid.Row="3" 
                                  ItemContainerStyle="{StaticResource ListViewSmallItemStretchStyle}"
                                  ItemClick="ContainItemsListView_ItemClick"
                                  IsItemClickEnabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ViewStoreItemModel">
                                        <Grid x:Name="ViewIconGrid" Height="30" Width="30" ToolTipService.ToolTip="{x:Bind Name}">
                                            <Border 
                                            Background="{x:Bind ColorBrush}" 
                                            CornerRadius="5" 
                                            BorderThickness="1" 
                                            BorderBrush="{ThemeResource SystemChromeBlackMediumColor}"/>

                                            <Image x:Name="ViewIconImage" Source="{x:Bind ImageSource, Mode=OneWay}" Height="20"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                        </StackPanel>
                    </StackPanel>

                    <Image
                        Grid.Column="1"
                        x:Name="PART_Image"
                        Source="{Binding CardImageSource, ElementName=RootControl}"
                        Width="{Binding IconSize, ElementName=RootControl}"
                        Height="{Binding IconSize, ElementName=RootControl}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Button>
    </Grid>
</UserControl>
