<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CDPI_UI.Controls.MainPage.WidgetUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPI_UI.Controls.MainPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:viewmodels="using:CDPI_UI.ViewModels"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:conv="using:CDPI_UI.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ToggleButton x:Name="WidgetToggleButton" HorizontalAlignment="Right" Click="WidgetToggleButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="WidgetStateTextBlock"/>
                <Viewbox Width="16" Height="16">
                    <AnimatedIcon x:Name="WidgetAnimatedIcon" >
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedChevronUpDownSmallVisualSource/>
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource x:Name="FallbackIcon" Glyph="&#xE70E;"/>
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Viewbox>
            </StackPanel>
        </ToggleButton>
        <ItemsRepeater x:Name="WidgetsItemsRepeater" Grid.Row="2" Visibility="{x:Bind WidgetToggleButton.IsChecked, Converter={StaticResource BoolToVis}, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:WidgetViewModel">
                    <Button Padding="6" 
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                            MinWidth="110" MinHeight="110"
                            ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
                            Tag="{x:Bind Id, Mode=OneWay}"
                            Click="Widget_Click">
                        <Grid>
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="{x:Bind ShowOpenInNewWindowBadge, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                            <BitmapIcon UriSource="{x:Bind UriImageSource, Mode=OneWay}" ShowAsMonochrome="{x:Bind ShowAsMonochrome, Mode=OneWay}" Height="20" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Bottom" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            <ItemsRepeater.Transitions>
                <TransitionCollection>
                    <PopupThemeTransition/>
                </TransitionCollection>
            </ItemsRepeater.Transitions>
            <ItemsRepeater.Layout>
                <controls:StaggeredLayout ItemsStretch="Fill"
                                  ColumnSpacing="5"
                                  RowSpacing="5"
                                  DesiredColumnWidth="110"/>
            </ItemsRepeater.Layout>
        </ItemsRepeater>
    </Grid>
</UserControl>
