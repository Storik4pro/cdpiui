<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CDPIUI.Controls.CreateConfigHelper.ConfigMakerUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:CDPIUI.Controls.CreateConfigHelper"
    xmlns:l="using:WinUI3Localizer"
    xmlns:navigation="using:CDPIUI.Controls.Navigation"
    xmlns:textcontrolbox="using:TextControlBoxNS"
    xmlns:universal="using:CDPIUI.Controls.Universal"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    mc:Ignorable="d"
    xmlns:conv="using:CDPIUI.Converters"
    xmlns:def="using:CDPIUI.Controls.Default" xmlns:uexp="using:CDPIUI.Helper.UserExperience">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Name="BoolToVis"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid x:Name="MainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PresetFilesColumn" Width="0" />
                <ColumnDefinition x:Name="PresetFilesSizerColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="VerticalSizerColumn" Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="PresetFilesPanel"
                Width="230"
                MinWidth="150"
                Visibility="Collapsed"
                SizeChanged="ResizablePanel_SizeChanged"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <def:PanelTitleUserControl l:Uids.Uid="ConfigMakerPresetFilesHeader" Click="CloseTreeViewButton_Click"/>
                    <TreeView
                        x:Name="PresetFilesTreeView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource BoxTreeViewStyle}"
                        CanDrag="False"
                        CanReorderItems="False"
                        CanDragItems="False"
                        AllowDrop="False"
                        >
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="110" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;"
                                        Visibility="{Binding Content.MissingVisibility}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{Binding Content.DisplayName}"
                                        TextTrimming="CharacterEllipsis">
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="{Binding Content.ToolTip}" />
                                        </ToolTipService.ToolTip>
                                    </TextBlock>
                                    <StackPanel x:Name="PresetFileActionsPanel" 
                                                Tag="{Binding Content.File}" 
                                                Spacing="5" 
                                                Orientation="Horizontal" 
                                                Grid.Column="2" 
                                                Visibility="{Binding Content.ActionsVisibility}"
                                                Margin="0 0 5 0">
                                        <Button l:Uids.Uid="ConfigMakerPresetFileReplaceButton" Padding="6" Click="ReplacePresetFileItem_Click" Tag="{Binding Tag, ElementName=PresetFileActionsPanel}" Background="Transparent" BorderThickness="0" Visibility="{Binding Content.MissingVisibility}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                                <TextBlock l:Uids.Uid="ConfigMakerPresetFileReplaceText" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button l:Uids.Uid="ConfigMakerPresetFileOpenButton" Padding="6" Click="OpenPresetFileItem_Click" Tag="{Binding Tag, ElementName=PresetFileActionsPanel}" Background="Transparent" BorderThickness="0" Visibility="{Binding Content.ExistingActionsVisibility}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"  />
                                        </Button>
                                        <Button l:Uids.Uid="ConfigMakerPresetFileShowInFolderButton" Padding="6" Click="ShowPresetFileInFolderItem_Click" Tag="{Binding Tag, ElementName=PresetFileActionsPanel}" Background="Transparent" BorderThickness="0" Visibility="{Binding Content.ExistingActionsVisibility}">
                                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        </Button>

                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <controls:ContentSizer
                x:Name="PresetFilesContentSizer"
                Grid.Column="1"
                Width="12"
                Visibility="Collapsed"
                TargetControl="{Binding ElementName=PresetFilesPanel}" />

            <Grid x:Name="EditorWorkspace" Grid.Column="2" Width="620" MinWidth="360">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HorizontalSizerRow" Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="EditorPanel"
                    Height="420"
                    MinHeight="180"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <InfoBar
                            x:Name="EditorInfoBar"
                            Margin="8"
                            IsClosable="True"
                            IsOpen="False" />
                        <textcontrolbox:TextControlBox
                            x:Name="CommandEditor"
                            Grid.Row="1"
                            MinHeight="160"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            TextChanged="CommandEditor_TextChanged"
                            ZoomChanged="CommandEditor_ZoomChanged"
                            FontFamily="{x:Bind uexp:ConsoleFontHelper.Instance.FontFamily, Mode=OneWay}"/>

                        <universal:SearchUserControl
                            x:Name="EditorSearchControl"
                            Grid.Row="0"
                            MaxWidth="600"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Canvas.ZIndex="2" />

                        <Border
                            x:Name="EditorStatusBar"
                            Grid.Row="2"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
                            <Grid Padding="0" ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                    <ColumnDefinition Width="Auto" MinWidth="30" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Padding="7,3" Background="Transparent" BorderThickness="0" Click="SearchButton_Click" CornerRadius="0" 
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                                    </Button.KeyboardAccelerators>
                                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip l:Uids.Uid="ConfigMakerSearchToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <Button x:Name="ReplaceEditorButton" Grid.Column="1" Padding="7,3" Background="Transparent" BorderThickness="0" Click="ReplaceButton_Click" 
                                        CornerRadius="0" 
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Modifiers="Control" Key="H" />
                                    </Button.KeyboardAccelerators>
                                    <FontIcon Glyph="&#xE8B0;" FontSize="13" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip l:Uids.Uid="ConfigMakerReplaceToolTip" />
                                    </ToolTipService.ToolTip>
                                </Button>
                                <universal:ContentSeparator Grid.Column="2"  Height="18"/>
                                <Button l:Uids.Uid="ConfigMakerZoomOut"  Grid.Column="3" Padding="7,3" Background="Transparent" BorderThickness="0" 
                                        Click="ZoomOutButton_Click"
                                        CornerRadius="0" 
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <FontIcon Glyph="&#xE71F;" FontSize="13" />
                                </Button>
                                <Button
                                    x:Name="ZoomResetButton"
                                    l:Uids.Uid="ZoomResetButton"
                                    Grid.Column="4"
                                    MinWidth="50"
                                    Padding="5,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ZoomResetButton_Click"
                                    CornerRadius="0" 
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch">
                                </Button>
                                <Button l:Uids.Uid="ConfigMakerZoomIn" Grid.Column="5" Padding="7,3" Background="Transparent" BorderThickness="0" Click="ZoomInButton_Click" CornerRadius="0" 
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <FontIcon Glyph="&#xE8A3;" FontSize="13" />
                                </Button>

                                <universal:ContentSeparator Grid.Column="6"  Height="18"/>

                                <Button Grid.Column="7" Padding="7,3" Background="Transparent" BorderThickness="0" CornerRadius="0" 
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <FontIcon Glyph="&#xE790;" FontSize="13" />
                                    <ToolTipService.ToolTip>
                                        <ToolTip l:Uids.Uid="ConfigMakerBackgroundToolTip" />
                                    </ToolTipService.ToolTip>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Top">
                                            <RadioMenuFlyoutItem x:Name="DefaultBackgroundItem" l:Uids.Uid="DefaultBackgroundMenuItem" GroupName="ConfigMakerBackground" Click="EditorBackgroundItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="MicaBackgroundItem" l:Uids.Uid="MicaBackgroundMenuItem" GroupName="ConfigMakerBackground" Click="EditorBackgroundItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="MicaAltBackgroundItem" l:Uids.Uid="MicaAltMenuItem" GroupName="ConfigMakerBackground" Click="EditorBackgroundItem_Click" />
                                            <RadioMenuFlyoutItem x:Name="MicaSmokeBackgroundItem" l:Uids.Uid="MicaSmokeMenuItem" GroupName="ConfigMakerBackground" Click="EditorBackgroundItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <Button
                                    Grid.Column="9"
                                    Padding="8,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DiagnosticsStatusButton_Click"
                                    CornerRadius="0"
                                    VerticalAlignment="Stretch"
                                    Visibility="{x:Bind IsErrorCheckEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock x:Name="ErrorCountTextBlock" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                
                                <Button
                                    Grid.Column="10"
                                    Padding="8,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DiagnosticsStatusButton_Click"
                                    CornerRadius="0"
                                    VerticalAlignment="Stretch"
                                    Visibility="{x:Bind IsErrorCheckEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock x:Name="WarningCountTextBlock" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <controls:ContentSizer
                    x:Name="HorizontalContentSizer"
                    Grid.Row="1"
                    Height="12"
                    Orientation="Horizontal"
                    TargetControl="{Binding ElementName=EditorPanel}" />

                <Grid x:Name="BottomPanel" Grid.Row="2" MinHeight="110" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <def:PanelTitleUserControl  Click="CloseCommandsBottomPanelButton_Click" VerticalAlignment="Top" Height="46"/>
                    <navigation:AnimatedSelectorBar
                        x:Name="BottomSelector"
                        AreTransitionsEnabled="False"
                        Grid.Row="1">
                        <navigation:AnimatedSelectorBarItem x:Name="OutputSelectorItem" l:Uids.Uid="ConfigMakerOutputTab">
                            <universal:ViewConfigOutput x:Name="ConfigOutput" />
                        </navigation:AnimatedSelectorBarItem>
                        <navigation:AnimatedSelectorBarItem x:Name="DiagnosticsSelectorItem" l:Uids.Uid="ConfigMakerDiagnosticsTab">
                            <Grid RowSpacing="6">
                                <ListView
                                    x:Name="DiagnosticsListView"
                                    Grid.Row="1"
                                    Margin="0,0"
                                    ItemsSource="{x:Bind Diagnostics}"
                                    ItemContainerTransitions="{x:Null}"
                                    DoubleTapped="DiagnosticsListView_DoubleTapped"
                                    SelectionChanged="DiagnosticsListView_SelectionChanged">
                                    <ListView.Header>
                                        <Border Padding="8,4,0,4"
                                            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                            CornerRadius="4">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:StickyHeaderBehavior />
                                            </interactivity:Interaction.Behaviors>
                                            <controls:DataTable ColumnSpacing="16">
                                                <controls:DataColumn l:Uids.Uid="ConfigMakerDiagnosticSeverityColumn"/>
                                                <controls:DataColumn l:Uids.Uid="ConfigMakerDiagnosticCodeColumn" />
                                                <controls:DataColumn CanResize="True" l:Uids.Uid="ConfigMakerDiagnosticDescriptionColumn" DesiredWidth="*"/>
                                                <controls:DataColumn l:Uids.Uid="ConfigMakerDiagnosticFlagColumn" DesiredWidth="100" />
                                                <controls:DataColumn l:Uids.Uid="ConfigMakerDiagnosticLineColumn" DesiredWidth="100"/>
                                            </controls:DataTable>
                                        </Border>
                                    </ListView.Header>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ConfigMakerDiagnosticViewModel">
                                            <controls:DataRow HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind SeverityText}" Foreground="{x:Bind SeverityBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Source.Code}" FontSize="{x:Bind uexp:ConsoleFontHelper.Instance.FontSize, Mode=OneWay}" FontFamily="{x:Bind uexp:ConsoleFontHelper.Instance.FontFamily, Mode=OneWay}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Source.Token}" FontSize="{x:Bind uexp:ConsoleFontHelper.Instance.FontSize, Mode=OneWay}" FontFamily="{x:Bind uexp:ConsoleFontHelper.Instance.FontFamily, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind Source.Line}" />
                                            </controls:DataRow>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}"
                                               TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                </ListView>
                            </Grid>
                        </navigation:AnimatedSelectorBarItem>
                        <navigation:AnimatedSelectorBarItem x:Name="PresetGroupsSelectorItem" l:Uids.Uid="ConfigMakerPresetGroupsTab">
                            <TreeView
                                x:Name="PresetGroupsTreeView"
                                Margin="0,0"
                                SelectionMode="Single" 
                                CanDrag="False"
                                CanReorderItems="False"
                                CanDragItems="False"
                                AllowDrop="False"
                                DoubleTapped="PresetGroupsTreeView_DoubleTapped">
                                <TreeView.ItemContainerStyle>
                                    <Style
                                        BasedOn="{StaticResource BoxTreeViewStyle}"
                                        TargetType="TreeViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Margin="{Binding Content.ContentMargin}"
                                            ToolTipService.ToolTip="{Binding Content.Description}">
                                            <TextBlock
                                                FontFamily="{Binding Content.TitleFontFamily}"
                                                Text="{Binding Content.Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Content.Description}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Content.DescriptionVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </navigation:AnimatedSelectorBarItem>
                    </navigation:AnimatedSelectorBar>
                </Grid>
            </Grid>

            <controls:ContentSizer
                x:Name="VerticalContentSizer"
                Grid.Column="3"
                Width="12"
                TargetControl="{Binding ElementName=EditorWorkspace}" />

            <Border
                x:Name="CommandPanel"
                Grid.Column="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <def:PanelTitleUserControl l:Uids.Uid="ConfigMakerCommandsHeader" Click="CloseCommandsViewButton_Click"/>
                    <Grid Padding="12" RowSpacing="8" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>



                        <ComboBox
                            x:Name="ModuleComboBox"
                            Grid.Row="0"
                            l:Uids.Uid="ConfigMakerModuleComboBox"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind CommandModules}"
                            DisplayMemberPath="DisplayName"
                            SelectionChanged="ModuleComboBox_SelectionChanged" />

                        <AutoSuggestBox
                            x:Name="CommandSearchBox"
                            Grid.Row="1"
                            l:Uids.Uid="ConfigMakerCommandSearchBox"
                            QueryIcon="Find"
                            TextChanged="CommandSearchBox_TextChanged" />

                        <Grid Grid.Row="2">
                            <TextBlock
                                x:Name="UsageTextBlock"
                                TextWrapping="Wrap"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressRing x:Name="HelpProgressRing" HorizontalAlignment="Right" Width="20" Height="20" IsActive="False" />
                        </Grid>

                        <ListBox
                            x:Name="CommandListView"
                            Grid.Row="3"
                            ItemsSource="{x:Bind CommandOptions}"
                            SelectionChanged="CommandListView_SelectionChanged"
                            Grid.RowSpan="2"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ConfigMakerCommandOptionViewModel">
                                    <TextBlock Text="{x:Bind DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="CommandDetailsBorder"
                            Grid.Row="4"
                            Margin="0,4,0,0"
                            Padding="10"
                            Visibility="Collapsed"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock x:Name="SelectedCommandNameTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="SelectedCommandSyntaxTextBlock" FontSize="{x:Bind uexp:ConsoleFontHelper.Instance.FontSize, Mode=OneWay}" FontFamily="{x:Bind uexp:ConsoleFontHelper.Instance.FontFamily, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" Margin="0 0 -10 0">
                                    <StackPanel Spacing="7" Margin="0 0 15 0">
                                        <TextBlock x:Name="SelectedCommandDescriptionTextBlock" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="CommandArgumentPanel" Spacing="4">
                                            <TextBlock x:Name="CommandArgumentLabelTextBlock" Style="{ThemeResource CaptionTextBlockStyle}" />
                                            <TextBox x:Name="CommandArgumentTextBox" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="CopyButton" l:Uids.Uid="ConfigMakerCopyCommandButton" Click="CopyCommandButton_Click" CornerRadius="0" Width="150" IsEnabled="False"/>
                            <Button x:Name="InsertButton" l:Uids.Uid="ConfigMakerInsertCommandButton" Click="InsertCommandButton_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="0"  Width="150" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
