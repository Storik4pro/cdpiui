<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    l:Uids.Uid="ConfigShareTitleContentDialog"
    x:Class="CDPIUI.Controls.Dialogs.ConfigShare.ConfigShareExportContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Closing="Dialog_Closing"
    Style="{ThemeResource DefaultContentDialogStyle}"
    xmlns:l="using:WinUI3Localizer"
    xmlns:conv="using:CDPIUI.Converters">

    <ContentDialog.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </ContentDialog.Resources>
    <StackPanel Spacing="12" Width="360">

        <TextBox x:Name="PresetNameBox" MaxLength="120" TextChanged="PresetFields_TextChanged" Visibility="{x:Bind PresetNameBox.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        <TextBox x:Name="DeveloperNameBox" MaxLength="120" TextChanged="PresetFields_TextChanged" Visibility="{x:Bind DeveloperNameBox.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
        
        <ProgressBar x:Name="ExportProgress" IsIndeterminate="True" Visibility="Collapsed" />
        <TextBlock x:Name="ExportStatus" TextWrapping="Wrap" Visibility="Collapsed" />
        <InfoBar x:Name="ExportError" Severity="Error" IsOpen="False" IsClosable="False" />

        <Button 
            x:Name="SaveButton" 
            HorizontalContentAlignment="Stretch" 
            HorizontalAlignment="Stretch" 
            Click="SaveButton_Click" 
            Visibility="{x:Bind SaveButton.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE792;" FontSize="24"/>
                <StackPanel Grid.Column="1">
                    <TextBlock l:Uids.Uid="ExportToFileTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock l:Uids.Uid="ExportToFileTipTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button 
            x:Name="ShareButton" 
            HorizontalContentAlignment="Stretch" 
            HorizontalAlignment="Stretch" 
            Click="ShareButton_Click" 
            Visibility="{x:Bind ShareButton.IsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xF3E2;" FontSize="24"/>
                <StackPanel Grid.Column="1">
                    <TextBlock l:Uids.Uid="ShareToFileTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock l:Uids.Uid="ShareToFileTipTextBlock" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Button>

        <Button 
            x:Name="CancelButton" 
            HorizontalContentAlignment="Stretch" 
            HorizontalAlignment="Stretch" 
            Click="CancelButton_Click">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE711;" FontSize="24"/>
                <StackPanel Grid.Column="1">
                    <TextBlock l:Uids.Uid="CancelTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
            </Grid>
        </Button>
    </StackPanel>
</ContentDialog>
