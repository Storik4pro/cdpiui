<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Name="ContentDialog"
    x:Class="CDPIUI.Controls.Dialogs.FontSettingsContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPIUI.Controls.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:l="using:WinUI3Localizer"
    xmlns:uexp="using:CDPIUI.Helper.UserExperience"
    l:Uids.Uid="FontContentDialog"
    DefaultButton="Secondary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid Width="325">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="1" Padding="0, 0, 0, -10" MaxHeight="300">
            <StackPanel Spacing="10" Margin="0 0 0 10" Grid.Column="1">
                <StackPanel>
                    <TextBlock l:Uids.Uid="FontMenuItem" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <CheckBox 
                            l:Uids.Uid="ShowOnlyMonospaceFonts"
                            IsChecked="{x:Bind uexp:ConsoleFontHelper.Instance.OnlyMonospace, Mode=TwoWay}"/>
                    <ComboBox 
                            x:Name="FontChooseComboBox"
                            ItemsSource="{x:Bind uexp:ConsoleFontHelper.Instance.AvailableFonts}" 
                            SelectedItem="{x:Bind uexp:ConsoleFontHelper.Instance.SelectedFontFamilyInCollection, Mode=OneWay}" 
                            HorizontalAlignment="Stretch"
                            MinHeight="50">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="FontFamily">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind Source, Mode=OneWay}" FontFamily="{x:Bind}"/>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Source, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock l:Uids.Uid="FontSizeTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <ComboBox x:Name="FontSizeComboBox" 
                              IsEditable="False" 
                              ItemsSource="{x:Bind uexp:ConsoleFontHelper.Instance.FontSizes}" 
                              SelectedItem="{x:Bind uexp:ConsoleFontHelper.Instance.FontSize, Mode=OneWay}" 
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
