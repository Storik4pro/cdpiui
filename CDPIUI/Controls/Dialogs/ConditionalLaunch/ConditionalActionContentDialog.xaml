<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CDPIUI.Controls.Dialogs.ConditionalLaunch.ConditionalActionContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    Style="{ThemeResource DefaultContentDialogStyle}"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <DataTemplate x:Key="ConditionalPresetChoiceTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding PackName}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="560" Spacing="12">
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />
            <ComboBox
                x:Name="ActionTypeComboBox"
                l:Uids.Uid="CL_ActionTypeComboBox"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch"
                SelectionChanged="ActionTypeComboBox_SelectionChanged"/>
            <StackPanel x:Name="ActionParametersPanel" Spacing="10" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
