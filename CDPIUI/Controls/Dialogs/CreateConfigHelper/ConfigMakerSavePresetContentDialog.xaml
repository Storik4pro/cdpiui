<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="CDPIUI.Controls.Dialogs.CreateConfigHelper.ConfigMakerSavePresetContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel Width="400" Spacing="10">
        <TextBlock l:Uids.Uid="ConfigMakerSavePresetDescription" TextWrapping="Wrap" />
        <TextBox
            x:Name="PresetNameTextBox"
            l:Uids.Uid="ConfigMakerPresetNameTextBox"
            TextChanged="PresetNameTextBox_TextChanged" />
    </StackPanel>
</ContentDialog>
