<?xml version="1.0" encoding="utf-8"?>
<tpl:TemplatePage
    x:Class="CDPIUI.Views.ConfigImportUtil.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    xmlns:tpl="using:CDPIUI.Controls.Default"
    mc:Ignorable="d"
    xmlns:ucontrols="using:CDPIUI.Controls.Universal"
    xmlns:conv="using:CDPIUI.Converters"
    xmlns:vm="using:CDPIUI.ViewModels"
    xmlns:nv="using:CDPIUI.Controls.Navigation">

    <Grid Unloaded="MainPage_Unloaded">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Name="BoolToVisibilityConverter"/>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <nv:AnimatedHorizontalContentViewer x:Name="MainContent">
            <nv:AnimatedHorizontalContentItem x:Name="SelectionStep">
                <Grid Padding="20 0">
                    <StackPanel x:Name="LetsBeginStackPanel">
                        <TextBlock l:Uids.Uid="ConfigImportSelectStepTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <RichTextBlock Margin="15" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run l:Uids.Uid="ConfigImportWizardTip"/>
                            </Paragraph>
                            <Paragraph Margin="0 20 0 0">
                                <Run l:Uids.Uid="ClickNextToBegin"/>
                            </Paragraph>
                        </RichTextBlock>
                    </StackPanel>
                </Grid>
            </nv:AnimatedHorizontalContentItem>
            <nv:AnimatedHorizontalContentItem x:Name="ProgressStep">
                <Grid Padding="20 0">
                    <StackPanel  Visibility="Visible">
                        <TextBlock l:Uids.Uid="ConfigImportProgressStepTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <RichTextBlock Margin="15" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run l:Uids.Uid="ConfigImportProgressStepDescription"/>
                            </Paragraph>
                        </RichTextBlock>
                    </StackPanel>
                </Grid>
            </nv:AnimatedHorizontalContentItem>
            <nv:AnimatedHorizontalContentItem x:Name="MissingFilesStep">
                <Grid Padding="20 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock
                            l:Uids.Uid="ConfigImportMissingFilesStepTitle"
                            Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock
                            l:Uids.Uid="ConfigImportMissingFilesStepDescription"
                            TextWrapping="Wrap"
                            MaxWidth="700"
                            HorizontalAlignment="Left"/>
                    </StackPanel>

                    <ListView
                        x:Name="MissingFilesItemsControl"
                        Grid.Row="1"
                        Margin="0 8 -15 0"
                        SelectionMode="None"
                        ItemContainerStyle="{StaticResource ListViewItemStretchStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ConfigName}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                        <TextBlock Text="{Binding MissingPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <StackPanel Spacing="2">
                                            <TextBlock l:Uids.Uid="ConfigImportMissingFileSuggestionLabel" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                IsEnabled="{Binding HasSuggestion}"
                                                Tag="{Binding}"
                                                Click="UseSuggestedFileButton_Click"
                                                Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                                    <TextBlock l:Uids.Uid="AutoCorrectApplyTextBlock"/>
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                l:Uids.Uid="ConfigImportChooseReplacementButton"
                                                Tag="{Binding}"
                                                Click="ChooseReplacementButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                                    <TextBlock l:Uids.Uid="AutoCorrectSelectManuallyTextBlock"/>
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                l:Uids.Uid="ConfigImportUseEmptyFileButton"
                                                Tag="{Binding}"
                                                Click="UseEmptyFileButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5" Margin="0 0 15 0" Padding="0 10"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>
            </nv:AnimatedHorizontalContentItem>
            <nv:AnimatedHorizontalContentItem x:Name="CompletedStep">
                <Grid Padding="20 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock
                    l:Uids.Uid="ConfigImportCompletedStepTitle"
                    Style="{ThemeResource TitleTextBlockStyle}"/>
                        <InfoBar x:Name="CompletionInfoBar" IsOpen="True" IsClosable="True"/>
                    </StackPanel>


                    <ListView 
                        x:Name="ResultItemsControl"
                        Margin="0 0 -15 0" 
                        Grid.Row="1" 
                        ItemContainerStyle="{StaticResource ListViewItemStretchStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="3" Grid.Column="1">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox
                                                Grid.Column="1"
                                                ItemsSource="{Binding Components}"
                                                SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                                                DisplayMemberPath="ShortName"
                                                HorizontalAlignment="Stretch"/>
                                                <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="10">
                                                    <Button 
                                                    Padding="7 6"
                                                    IsEnabled="{Binding CanTest}"
                                                    Tag="{Binding}"
                                                    Click="TestButton_Click">
                                                        <FontIcon Glyph="{Binding TestButtonGlyph}"  FontSize="16"/>
                                                        <ToolTipService.ToolTip>
                                                            <TextBlock Text="{Binding TestButtonText}"/>
                                                        </ToolTipService.ToolTip>
                                                    </Button>
                                                    <Button 
                                                    Style="{ThemeResource AccentButtonStyle}" 
                                                    Padding="7 6"
                                                    IsEnabled="{Binding CanSave}"
                                                    Tag="{Binding}"
                                                    Click="SaveButton_Click">

                                                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                                        <ToolTipService.ToolTip>
                                                            <TextBlock Text="{Binding SaveButtonText}"/>
                                                        </ToolTipService.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <Grid ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <HyperlinkButton 
                                        Padding="0" 
                                        Background="Transparent" 
                                        BorderBrush="Transparent" 
                                        HorizontalContentAlignment="Stretch"
                                        Tag="{Binding}"
                                        Click="DetailsButton_Click">
                                                <Grid ColumnSpacing="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="auto"/>
                                                        <ColumnDefinition Width="auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon 
                                                Glyph="{Binding StatusGlyph}"
                                                FontSize="14"
                                                Margin="0 2 0 0"
                                                Foreground="{Binding StatusForeground}"/>
                                                    <TextBlock 
                                                Grid.Column="1" 
                                                Text="{Binding StatusText}" 
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextDecorations="Underline"
                                                Foreground="{Binding StatusForeground}"/>
                                                </Grid>
                                            </HyperlinkButton>
                                            <ucontrols:ContentSeparator Grid.Column="1"/>
                                            <TextBlock Text="{Binding SourcePath}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}" 
                                               TextTrimming="CharacterEllipsis" 
                                               Grid.Column="2"/>
                                        </Grid>

                                        <Grid Visibility="{Binding IsUnsuitable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" 
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"/>
                                            <Grid ColumnSpacing="5" Padding="10 5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE814;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="16" />

                                                <TextBlock Text="{Binding SuitabilityMessage}" Grid.Column="1"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="5" Margin="0 0 15 0" Padding="0 10 0 10"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Grid>
            </nv:AnimatedHorizontalContentItem>
            <nv:AnimatedHorizontalContentItem x:Name="WorkDoneStep">
                <Grid Padding="20 0">
                    <StackPanel>
                        <TextBlock l:Uids.Uid="ConfigImportCompletedStepTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <RichTextBlock Margin="15" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run l:Uids.Uid="ConfigImportWizardDoneTip"/>
                            </Paragraph>
                            <Paragraph Margin="0 20 0 0">
                                <Run l:Uids.Uid="ClickExitToExit"/>
                            </Paragraph>
                        </RichTextBlock>
                    </StackPanel>
                </Grid>
            </nv:AnimatedHorizontalContentItem>
        </nv:AnimatedHorizontalContentViewer>
        <ucontrols:UtilityButtonControls x:Name="UtilityButtonContols" Grid.Row="1" HelpUrl="Utils/ImportConfig">
            <Button x:Name="CancelButton" l:Uids.Uid="ExitButton" MinWidth="150" Click="CancelButton_Click" IsEnabled="True"/>
            <Button x:Name="NextButton" 
                    l:Uids.Uid="GoForwardButton" 
                    MinWidth="150" 
                    Click="NextButton_Click" 
                    IsEnabled="True" 
                    Style="{ThemeResource AccentButtonStyle}"/>
        </ucontrols:UtilityButtonControls>
    </Grid>
</tpl:TemplatePage>
