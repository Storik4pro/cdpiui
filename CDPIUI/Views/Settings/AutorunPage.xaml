<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CDPIUI.Views.Settings.AutorunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPIUI.Views.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:conv="using:CDPIUI.Converters"
    xmlns:viewmodels="using:CDPIUI.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:l="using:WinUI3Localizer">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="SmallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="contentSV.Padding" Value="16,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="contentSV.Padding" Value="20,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainPanel.HorizontalAlignment" Value="Center"/>
                        <Setter Target="MainPanel.Width" Value="1060px"/>
                        <Setter Target="NavGrid.HorizontalAlignment" Value="Center"/>
                        <Setter Target="NavGrid.Width" Value="1060px"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="NavGrid" Margin="20 5 20 0">
            <Rectangle Fill="Transparent"/>
            <BreadcrumbBar x:Name="BreadcrumbBar" ItemClicked="BreadcrumbBar_ItemClicked">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BreadcrumbBarModel">
                        <BreadcrumbBarItem Content="{Binding}" AutomationProperties.Name="{Binding DisplayName}" Tag="{Binding Tag}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource TitleTextBlockStyle}"/>
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>

        <ScrollViewer x:Name="contentSV" Padding="20 0" Grid.Row="1">
            <StackPanel x:Name="MainPanel" Spacing="5" Margin="0 0 0 20">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition/>
                </StackPanel.ChildrenTransitions>

                <TextBlock l:Uids.Uid="BasicTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <controls:SettingsCard l:Uids.Uid="AutorunButton">
                    <ToggleSwitch x:Name="AutorunToggleSwitch" Grid.Column="1" VerticalAlignment="Center" Toggled="AutorunToggleSwitch_Toggled"   Margin="0, 0, 0, 0" />
                </controls:SettingsCard>

                <InfoBar
                    x:Name="AutorunWarningInfoBar"
                    l:Uids.Uid="AutorunWarningInfoBar"
                    Severity="Warning">
                </InfoBar>

                <controls:SettingsExpander x:Name="ComponentSettingsExpander" l:Uids.Uid="ComponentAutorunSettingsExpander" 
                                           IsExpanded="{x:Bind AutorunToggleSwitch.IsOn, Mode=OneWay}" IsEnabled="{x:Bind AutorunToggleSwitch.IsOn, Mode=OneWay}">
                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ViewComponentModel">
                            <controls:SettingsCard>
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="{x:Bind ImageSource, Mode=OneWay}" Width="20"/>
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.Header>
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"/>
                                </controls:SettingsCard.Header>
                                <ToggleSwitch x:Name="ComponentAutorunToggleSwitch" Tag="{x:Bind StoreId}" Toggled="ComponentAutorunToggleSwitch_Toggled" IsOn="{x:Bind IsUsedForAutorun, Mode=OneWay}"/>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                    <controls:SettingsExpander.ItemsFooter>
                        <InfoBar x:Name="NoComponentInstalledTextBlock" l:Uids.Uid="NoComponentInstalledInfoBar" IsClosable="False" IsOpen="True" CornerRadius="0" BorderThickness="0">
                            <InfoBar.ActionButton>
                                <HyperlinkButton x:Name="OpenStoreHyperlinkButton" Click="OpenStoreHyperlinkButton_Click">
                                    <TextBlock l:Uids.Uid="StoreOpenMenuItem"/>
                                </HyperlinkButton>
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </controls:SettingsExpander.ItemsFooter>
                </controls:SettingsExpander>

                <TextBlock l:Uids.Uid="AdditionalSettingsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0 20 0 0"/>

                <controls:SettingsCard l:Uids.Uid="HideToTrayOnStartupCard">
                    <ToggleSwitch x:Name="HideInTrayToggleSwitch" Grid.Column="1" VerticalAlignment="Center" Toggled="HideInTrayToggleSwitch_Toggled" Margin="0, 0, 0, 0" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
