<?xml version="1.0" encoding="utf-8"?>
<tpl:TemplatePage
    x:Class="CDPIUI.Views.BlockCheck2.ReportHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="using:WinUI3Localizer"
    xmlns:local="using:CDPIUI.Views.BlockCheck2"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tpl="using:CDPIUI.Controls.Default"
    xmlns:universal="using:CDPIUI.Controls.Universal"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5" Padding="20 0">
            <TextBlock
                l:Uids.Uid="BlockCheck2HistoryPageTitle"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                l:Uids.Uid="BlockCheck2HistoryPageDescription"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Padding="20 0"
            Margin="0 10 0 2">
            <Button
                l:Uids.Uid="BlockCheck2HistoryOpenFileButton"
                Click="OpenFileButton_Click" />
            <Button
                l:Uids.Uid="BlockCheck2HistoryOpenFolderButton"
                Click="OpenFolderButton_Click" />
            <Button
                l:Uids.Uid="BlockCheck2HistoryRefreshButton"
                Click="RefreshButton_Click" />
        </StackPanel>

        <InfoBar
            Padding="20 0"
            x:Name="StatusInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="3" Padding="20 0 0 0">
            <ProgressRing
                x:Name="LoadingProgressRing"
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="EmptyHistoryTextBlock"
                l:Uids.Uid="BlockCheck2HistoryEmptyText"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ListView
                x:Name="ReportsListView"
                ItemsSource="{x:Bind HistoryItems, Mode=OneWay}"
                ItemContainerStyle="{StaticResource ListViewItemStretchStyle}"
                SelectionMode="None"
                Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BlockCheck2ReportHistoryItemViewModel">
                        <controls:SettingsCard
                            Header="{x:Bind Title}"
                            Description="{x:Bind Description}"
                            IsClickEnabled="True"
                            Click="ReportSettingsCard_Click"
                            Margin="0 0 0 2">
                            <controls:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </controls:SettingsCard.ActionIcon>
                            <controls:SettingsCard.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        l:Uids.Uid="BlockCheck2HistoryShowFileButton"
                                        Tag="{x:Bind}"
                                        Click="ShowFileButton_Click"
                                        Padding="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    </Button>
                                    <Button
                                        l:Uids.Uid="BlockCheck2HistoryDeleteButton"
                                        Tag="{x:Bind}"
                                        Click="DeleteButton_Click"
                                        Padding="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingsCard.Content>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Margin="0 10 20 10"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>

        <universal:UtilityButtonControls Grid.Row="4">
            <Button
                l:Uids.Uid="GoBackButton"
                Click="BackButton_Click" />
        </universal:UtilityButtonControls>
    </Grid>
</tpl:TemplatePage>
