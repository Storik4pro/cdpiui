<?xml version="1.0" encoding="utf-8"?>
<tpl:TemplatePage
    x:Class="CDPIUI.Views.Store.ReadyKitsViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:store="using:CDPIUI.Controls.Store"
    xmlns:tpl="using:CDPIUI.Controls.Default"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StoreScrollViewer.Padding" Value="20,0,5,0"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1984"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentStackPanel.HorizontalAlignment" Value="Center"/>
                        <Setter Target="ContentStackPanel.Width" Value="1860"/>
                        <Setter Target="StoreScrollViewer.Padding" Value="20,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="LoadingGrid">
            <ProgressRing IsActive="True" IsIndeterminate="True"/>
        </Grid>

        <Grid x:Name="ErrorGrid" Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorTextBlock"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="520"/>
        </Grid>

        <ScrollViewer
            x:Name="StoreScrollViewer"
            Padding="20,0"
            Margin="0,20,0,0"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <StackPanel x:Name="ContentStackPanel" Spacing="20" MaxWidth="1860">
                <TextBlock
                    x:Name="PageTitleTextBlock"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>

                <ItemsRepeater ItemsSource="{x:Bind Bundles, Mode=OneWay}" Margin="0 0 15 0">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="store:StoreViewBundleItem">
                            <store:StoreReadyKitButton
                                Height="230"
                                MinWidth="0"
                                KitId="{x:Bind KitId, Mode=OneWay}"
                                CardImageSource="{x:Bind CardImageSource, Mode=OneWay}"
                                CardTitle="{x:Bind CardTitle, Mode=OneWay}"
                                CardSubtitle="{x:Bind CardSubtitle, Mode=OneWay}"
                                CardBackgroundBrush="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                Items="{x:Bind Items, Mode=OneWay}"
                                IconSize="70"
                                Click="ReadyKitButton_Click"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <controls:StaggeredLayout
                            DesiredColumnWidth="380"
                            ColumnSpacing="12"
                            RowSpacing="12"
                            ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</tpl:TemplatePage>
