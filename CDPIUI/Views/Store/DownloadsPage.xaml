<?xml version="1.0" encoding="utf-8"?>
<tpl:TemplatePage
    x:Name="RootPage"
    x:Class="CDPIUI.Views.Store.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPIUI.Views.Store"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:lcontrols="using:CDPIUI.Controls.Store"
    mc:Ignorable="d"
    xmlns:l="using:WinUI3Localizer"
    xmlns:tpl="using:CDPIUI.Controls.Default">

    <Grid>
        <ScrollViewer Padding="20">
            <StackPanel x:Name="MainStackPanel">
                <Grid>
                    <TextBlock l:Uids.Uid="DownloadsTextBlock" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Button x:Name="CheckForUpdatesButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" Click="CheckForUpdatesButton_Click">
                        <Grid>
                            <TextBlock l:Uids.Uid="CheckForUpdatesTextBlock" x:Name="CheckText" Opacity="0"/>
                            <ProgressRing x:Name="UpdateCheckProgressRing" IsIndeterminate="True" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Height="15" Width="15"/>
                        </Grid>
                    </Button>
                </Grid>
                <TextBlock l:Uids.Uid="NowDownloadingTextBlock" x:Name="NowDownloadingTextBlock" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <ListView x:Name="DownloadsListView" Margin="0 5 0 0" SelectionMode="None" Padding="0"
                      ItemContainerStyle="{StaticResource ListViewItemStretchStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadItemModel">
                            <lcontrols:StoreDownloadItemButton 
                                StoreId="{x:Bind StoreId, Mode=OneWay}"
                                OperationId="{x:Bind OperationId, Mode=OneWay}"
                                Title="{x:Bind Title, Mode=OneWay}"
                                Developer="{x:Bind Developer, Mode=OneWay}"
                                Category="{x:Bind Category, Mode=OneWay}"
                                CardImageSource="{x:Bind ImageSource, Mode=OneWay}"
                                CardBackgroundBrush="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                IsUpdateLikeButton="False"
                                IsErrorHappens="{x:Bind IsErrorHappens, Mode=OneWay}"
                                ClickCommand="{Binding ActionCommand, ElementName=RootPage}"
                                ClickCommandParameter="{Binding}"
                                Margin="0 2.5"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock l:Uids.Uid="AvailableUpdatesTextBlock" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <Grid x:Name="EmptyGrid" Height="60">
                    <TextBlock l:Uids.Uid="NoUpdatesAvailableRightNowTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" FontStyle="Italic"/>
                    
                </Grid>
                <ListView x:Name="UpdatesListView" Margin="0 5 0 0" SelectionMode="None" Padding="0"
                          ItemContainerStyle="{StaticResource ListViewItemStretchStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DownloadItemModel">
                            <lcontrols:StoreDownloadItemButton 
                                StoreId="{x:Bind StoreId, Mode=OneWay}"
                                Title="{x:Bind Title, Mode=OneWay}"
                                Developer="{x:Bind Developer, Mode=OneWay}"
                                Category="{x:Bind Category, Mode=OneWay}"
                                ServerVersion="{x:Bind ServerVersion, Mode=OneWay}"
                                CurrentVersion="{x:Bind CurrentVersion, Mode=OneWay}"
                                Description="{x:Bind Descripition, Mode=OneWay}"
                                CardImageSource="{x:Bind ImageSource, Mode=OneWay}"
                                IsUpdateLikeButton="True"
                                CardBackgroundBrush="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                ClickCommand="{Binding UpdateCommand, ElementName=RootPage}"
                                ClickCommandParameter="{Binding}"
                                Margin="0 2.5"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</tpl:TemplatePage>
