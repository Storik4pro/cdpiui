<?xml version="1.0" encoding="utf-8"?>
<tpl:TemplatePage
    x:Class="CDPIUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CDPIUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    xmlns:l="using:WinUI3Localizer"
    xmlns:viewmodels="using:CDPIUI.ViewModels"
    xmlns:tpl="using:CDPIUI.Controls.Default"
    xmlns:uexp="using:CDPIUI.Helper.UserExperience">

    <tpl:TemplatePage.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </tpl:TemplatePage.Resources>
    
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowStates">
                <VisualState x:Name="SmallState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="contentSV.Padding" Value="16,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="contentSV.Padding" Value="20,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainPanel.HorizontalAlignment" Value="Center"/>
                        <Setter Target="MainPanel.Width" Value="1060px"/>
                        <Setter Target="NavGrid.HorizontalAlignment" Value="Center"/>
                        <Setter Target="NavGrid.Width" Value="1060px"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Margin="20 5 20 0" x:Name="NavGrid">
            <Rectangle Fill="Transparent"/>
            <BreadcrumbBar x:Name="BreadcrumbBar">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BreadcrumbBarModel">
                        <BreadcrumbBarItem Content="{Binding}" AutomationProperties.Name="{Binding DisplayName}" Tag="{Binding Tag}">
                            <BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Style="{ThemeResource TitleTextBlockStyle}"/>
                                </DataTemplate>
                            </BreadcrumbBarItem.ContentTemplate>
                        </BreadcrumbBarItem>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>
        <ScrollViewer
            x:Name="contentSV"
            Grid.Row="1"
            Padding="20,0,20,0"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            
            <StackPanel x:Name="MainPanel" Spacing="{StaticResource SettingsCardSpacing}" Margin="0 0 0 20">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition/>
                </StackPanel.ChildrenTransitions>
                
                <TextBlock l:Uids.Uid="BasicTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <controls:SettingsCard l:Uids.Uid="LanguageSelector">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox Width="Auto" 
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{x:Bind uexp:LocalizationHelper.Instance.CurrentLanguage, Mode=OneWay}"
                              ItemsSource="{x:Bind uexp:LocalizationHelper.Instance.Languages}"
                              SelectionChanged="{x:Bind uexp:LocalizationHelper.Instance.HandleCollectionLanguageChanged}"/>
                </controls:SettingsCard>

                <controls:SettingsCard l:Uids.Uid="AutorunSettingsCard" x:Name="AutorunSettingsCard" IsClickEnabled="True" Click="AutorunSettingsCard_Click" Margin="0 10 0 0">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEB9D;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="PersonalizationSettingsCard" l:Uids.Uid="PersonalizationSettingsCard" IsClickEnabled="True" Click="PersonalizationSettingsCard_Click">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE771;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <controls:SettingsExpander l:Uids.Uid="NotificationSettingsExpander">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox x:Name="ComponentErrorWindowSetting" l:Uids.Uid="ComponentErrorWindowSetting" Click="ComponentErrorWindowSetting_Click"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox l:Uids.Uid="ProcessStateToast" x:Name="ProcessStateToast" Click="ProcessStateToast_Click" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox l:Uids.Uid="AppRunnedInTrayToast" x:Name="AppRunnedInTrayToast" Click="AppRunnedInTrayToast_Click" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox l:Uids.Uid="AppUpdatesToast" x:Name="AppUpdatesToast" Click="AppUpdatesToast_Click" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox l:Uids.Uid="StoreUpdatesToast" x:Name="StoreUpdatesToast" Click="StoreUpdatesToast_Click" />
                        </controls:SettingsCard>
                        <controls:SettingsCard ContentAlignment="Left">
                            <CheckBox
                                x:Name="ConditionalLaunchActionToast"
                                l:Uids.Uid="ConditionalLaunchActionToast"
                                Click="ConditionalLaunchActionToast_Click" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock l:Uids.Uid="ActionsTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0 10 0 0"/>
                <controls:SettingsCard x:Name="OpenComponentSiteListToEditCard" l:Uids.Uid="OpenComponentSiteListToEditCard" IsClickEnabled="True" Click="OpenComponentSiteListToEditCard_Click">
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard x:Name="OpenStoreSettingsCard" l:Uids.Uid="OpenStoreSettingsCard" IsClickEnabled="True" Click="OpenStoreSettingsCard_Click">
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>

                <controls:SettingsCard
                    x:Name="FileAssociationSettingsCard"
                    l:Uids.Uid="FileAssociationSettingsCard"
                    IsClickEnabled="True"
                    Click="InstallFileAssociationsButton_Click"
                    IsActionIconVisible="False">
                    <Button
                        x:Name="InstallFileAssociationsButton"
                        l:Uids.Uid="InstallButton"
                        Click="InstallFileAssociationsButton_Click" />
                </controls:SettingsCard>

                <TextBlock
                    l:Uids.Uid="PerformanceTextBlock"
                    Margin="0 10 0 0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />

                <controls:SettingsCard l:Uids.Uid="Zapret2LegacyHashValidationSettingsCard">
                    <ToggleSwitch
                        x:Name="Zapret2LegacyHashValidationToggleSwitch"
                        Toggled="Zapret2LegacyHashValidationToggleSwitch_Toggled" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</tpl:TemplatePage>
